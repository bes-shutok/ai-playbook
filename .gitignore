/.idea/
.DS_Store

# Python bytecode cache
__pycache__/
*.pyc

# Repo agent runtime dir at repo root only (bootstrap output; see `bootstrap-ai-playbook` skill)
/.ai-playbook/
# Legacy committed repo facts paths (deny accidental re-commit after migration)
/docs/facts.md
/docs/maintenance/facts.md
/docs/reviews

# Ephemeral session scratch (see docs/AGENTS.md)
/docs/tmp/

/.zcode/
/graphify-out/
/.zcodeignore

# Host-app skill-sync drop zone (externally managed, re-synced on demand; never vendor per Vendored Asset Sync Rules)
/agents/skills/synced/
