{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "./hooks/git-safety.sh",
        "matcher": "git ",
        "failClosed": false
      },
      {
        "command": "./hooks/review-staging-gate.sh commit",
        "matcher": "git commit",
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "./hooks/execute-plan-manifest-gate.sh",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false
      },
      {
        "command": "./hooks/instruction-size-warn.sh",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false
      },
      {
        "command": "./hooks/no-em-dash.sh",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false
      },
      {
        "command": "./hooks/no-em-dash.sh",
        "matcher": "mcp_slack_|updateConfluence|createConfluence|editJira|createJira|addCommentToJira|addWorklogToJira|createIssueLink|transitionJira",
        "failClosed": false
      }
    ],
    "postToolUse": [
      {
        "command": "./hooks/review-staging-gate.sh edit",
        "matcher": "Write|StrReplace|EditNotebook",
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "./hooks/review-staging-gate.sh stop",
        "failClosed": false
      }
    ]
  }
}
